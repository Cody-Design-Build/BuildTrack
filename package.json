{
  "name": "buildtrack",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode live",
    "build": "tsc --noEmit && vite build && node scripts/routes.mjs && node scripts/build-agent.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit && vite build && node scripts/build-agent.mjs",
    "db:push": "supabase db push --remote",
    "db:new": "supabase migration new",
    "company:list": "node scripts/company.mjs list",
    "invite:owner": "node scripts/company.mjs invite-owner",
    "test:db": "node supabase/tests/access.test.mjs && node supabase/tests/fresh-install.test.mjs",
    "test:agent": "node scripts/agent-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.460.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.21.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
