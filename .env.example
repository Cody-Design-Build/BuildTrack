# BuildTrack settings. Copy what you need into a .env.*.local file (git ignores those).
#
# With no Supabase settings the app runs on this browser's own storage (sample
# data, no sign-in). That's the default for `npm run dev`.
#
# .env.live.local   used by `npm run dev:live`: connects this machine to the LIVE
#                   team database. Edits there are real.
# Vercel            Production has these set in the Vercel project; Preview does not,
#                   so preview links run on sample data in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: your Google Workspace domain. Shows a Google sign-in button for those accounts
# (the Google app is Internal); without it, sign-in is by emailed code only.
# Who may actually sign in is decided by invites (npm run invite:owner, then Settings → Members).
VITE_TEAM_DOMAIN=

# Not for the app: used by `supabase config push` to fill in the Supabase SMTP password
# (supabase/config.jsonc → auth.email.smtp). A Resend key with sending access only.
# See docs/accounts-and-email.md.
RESEND_API_KEY=
